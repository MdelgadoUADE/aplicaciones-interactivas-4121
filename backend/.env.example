# Copiar a .env y completar con los datos reales:  cp .env.example .env
# El .env NO se sube a Git (está en .gitignore).

PORT=3000

# --- Base de datos -----------------------------------------------------
# Opción A) Supabase (Postgres administrado, requiere SSL)
#   Usar el host del POOLER, no el directo: db.<ref>.supabase.co resuelve
#   SOLO a IPv6 y en redes sin IPv6 falla con "connect ENETUNREACH".
#   En el pooler, el usuario es "postgres.<project-ref>" y la base es "postgres".
# DB_HOST=aws-0-us-east-1.pooler.supabase.com
# DB_PORT=5432
# DB_NAME=postgres
# DB_USER=postgres.<project-ref>
# DB_PASSWORD=tu_password_de_supabase
# DB_SSL=true
#
# Opción B) Postgres local (sin SSL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=libreria_db
DB_USER=postgres
DB_PASSWORD=tu_contraseña_local
DB_SSL=false

JWT_SECRET=una_clave_secreta_para_los_tokens
JWT_EXPIRES_IN=2h

# Código compartido con el equipo para poder registrarse como admin
# en POST /auth/register (sin esto, register responde 403).
ADMIN_INVITE_CODE=defini-un-codigo-y-compartilo-con-el-equipo

# Envío de mails (contacto + recuperación de contraseña).
EMAIL_HOST=smtp.tu-proveedor.com
EMAIL_PORT=587
EMAIL_USER=tu-usuario-smtp
EMAIL_PASSWORD=
EMAIL_FROM="Maxilibros <tu-usuario-smtp>"
EMAIL_COMERCIO=

# URL del frontend, usada para armar el link de reset de contraseña.
FRONTEND_URL=http://localhost:5173
